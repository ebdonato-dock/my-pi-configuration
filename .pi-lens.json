{
  "format": {
    "enabled": false
  },
  "autofix": {
    "enabled": false
  },
  "actionableWarnings": {
    "autoFix": {
      "enabled": false
    }
  },
  "rules": {
    "high-complexity": {
      "threshold": 25
    },
    "high-fan-out": {
      "threshold": 30
    }
  },
  "ignore": [
    ".git/**",
    "node_modules/**",
    "dist/**",
    "build/**",
    "out/**",
    "bin/**",
    "target/**",
    "obj/**",
    "vendor/**",
    "generated/**",
    "coverage/**",
    ".venv/**",
    ".gradle/**",
    ".next/**",
    ".nuxt/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.ruff_cache/**",
    "**/.mypy_cache/**",
    "**/*.lock",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/*.min.*",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/fixtures/**"
  ]
}
