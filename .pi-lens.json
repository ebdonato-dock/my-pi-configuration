{
  "format": {
    "enabled": false
  },
  "autofix": {
    "enabled": false
  },
  "actionableWarnings": {
    "autoFix": {
      "enabled": false
    }
  },
  "ignore": [
    ".git/**",
    "node_modules/**",
    "dist/**",
    "build/**",
    "out/**",
    "bin/**",
    "target/**",
    "obj/**",
    "vendor/**",
    "generated/**",
    "coverage/**",
    ".venv/**",
    ".gradle/**",
    ".next/**",
    ".nuxt/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.ruff_cache/**",
    "**/.mypy_cache/**"
  ]
}
